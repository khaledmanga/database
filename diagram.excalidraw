      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1045531529,
      "version": 819,
      "versionNonce": 734209289,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790305662149,
      "created": 1790304671278,
      "link": null,
      "locked": false,
      "text": "Case 1: If B+ tree only have leaf node and leaf node is full\n(1) Allocate new page. create new node, which have type is LEAF\n(2) Calculate position of separator mid = nkeys / 2\n(3) Move [mid, end] from old node to new node, erase [begin, mid] in old node\n(4) Update nkeys of old node = nkeys - mid, new node = nkeys - mid\n(5) Write old node and new node to disk\n(6) Choose separator, is the first element in old node\n(7) Create new root and update properties of new root",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Case 1: If B+ tree only have leaf node and leaf node is full\n(1) Allocate new page. create new node, which have type is LEAF\n(2) Calculate position of separator mid = nkeys / 2\n(3) Move [mid, end] from old node to new node, erase [begin, mid] in old node\n(4) Update nkeys of old node = nkeys - mid, new node = nkeys - mid\n(5) Write old node and new node to disk\n(6) Choose separator, is the first element in old node\n(7) Create new root and update properties of new root",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
